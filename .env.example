# PFM Core Ledger Java — Local Profile Example (Run ../init-local-development.sh to generate .env.local)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8082
GRPC_SERVER_PORT=9090
GRPC_REFLECTION_ENABLED=true
DB_URL=jdbc:postgresql://localhost:5432/pfm_core_ledger
DB_USERNAME=pfm_app_user
DB_PASSWORD=<LOCAL_POSTGRES_APP_PASSWORD>
FLYWAY_URL=jdbc:postgresql://localhost:5432/pfm_core_ledger
FLYWAY_USER=postgres
FLYWAY_PASSWORD=<LOCAL_POSTGRES_ADMIN_PASSWORD>
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-2
KMS_MASTER_KEY_ID=alias/pfm-master-key
# Datadog Unified Service Tagging & OpenTelemetry (Plug-and-Play ADR-010)
DD_SERVICE=pfm-core-ledger-java
DD_ENV=local
DD_VERSION=0.1.0-local
DD_LOGS_INJECTION=true
DD_TRACE_SAMPLE_RATE=1.0
DD_SITE=us3.datadoghq.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
CLOUDWATCH_LOGS_ENABLED=false
DD_API_KEY=
